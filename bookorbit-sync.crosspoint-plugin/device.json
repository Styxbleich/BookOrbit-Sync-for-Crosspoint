{
  "title": "BookOrbit Sync",
  "description": "Syncs highlights both ways and sends sessions to BookOrbit. Set up on the web page.",
  "config": {
    "file": "config.json"
  },
  "browse": {
    "format": "json"
  },
  "events": {
    "reader.session": {
      "request": {
        "method": "POST",
        "url": "{cfg.server}/api/v1/koreader/plugin/page-stats",
        "headers": {
          "Content-Type": "application/json",
          "x-auth-user": "{cfg.user}",
          "x-auth-key": "{cfg.key}"
        },
        "body": "{\"deviceId\":\"{cfg.device_id}\",\"deviceModel\":\"CrossPoint\",\"pluginVersion\":\"crosspoint/0.13.0\",\"books\":[{\"hash\":\"{event.document}\",\"events\":[{\"page\":{event.start_progress_bp},\"startTime\":{event.start_time},\"durationSeconds\":{event.duration_seconds},\"totalPages\":10000},{\"page\":{event.end_progress_bp},\"startTime\":{event.end_time},\"durationSeconds\":0,\"totalPages\":10000}]}]}"
      },
      "toast": "BookOrbit: session sent"
    }
  }
}
